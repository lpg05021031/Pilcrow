{
  "type": "object",
  "required": ["schema", "recorded", "count", "files"],
  "properties": {
    "schema": { "type": "integer", "enum": [1] },
    "recorded": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "count": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "sha256"],
        "properties": {
          "kind": { "type": "string", "enum": ["source", "build"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

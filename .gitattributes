# The installers and every embedded file must stay LF whatever core.autocrlf says:
# the Linux installer writes them out verbatim and bash would choke on CRLF.
* text=auto eol=lf
*.tmpl text eol=lf
*.sh text eol=lf
# The Windows shell script is embedded byte for byte (UTF-8 BOM + CRLF): never convert it.
*.ps1 -text
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.woff2 binary

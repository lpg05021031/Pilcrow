# 複製為 /etc/pr-review-suite/ado.env（chown root:root、chmod 600）
# ① ado-pr-tools —— 抓 PR。注意：systemd 的 EnvironmentFile 不支援「行內註解」，
# 所有註解獨立成行；等號右邊不可有空白或 # 尾巴（血淚教訓：URL 會出現 %20）。

# Azure DevOps PAT（權限至少 Code > Read）
ADO_PAT=changeme

# 有 proxy 才把下一行打開
# HTTPS_PROXY=http://proxy.corp:3128

# 公司自簽 CA：指向「系統合併包」。CA 請先收編進系統信任庫，
# 不要指向 /root 或 /home 底下的私人副本（權限與 systemd 沙箱雙重地雷）。
# Debian/Ubuntu 用下行；RHEL 系改 /etc/pki/tls/certs/ca-bundle.crt
ADO_VERIFY_SSL=/etc/ssl/certs/ca-certificates.crt

# ---- diff 抓取上限（常有大 PR 就調這裡）----
# 一條 PR 最多納入幾個檔案。超過的檔案「完全不會被抓下來」——
# 不只 LLM 看不到，semgrep/ruff 與確定性 MISSING-TEST 也掃不到。
# diff 開頭會留一行「# 注意：共 N 個檔案，僅呈現前 M 個」。
ADO_DIFF_MAX_FILES=100

# 單檔內容上限（bytes），任一側超過就整檔略過並留註記
# ADO_DIFF_MAX_FILE_BYTES=200000

# 抓檔併發度。每個檔案要抓 base/head 兩份，100 檔 = 200 次請求；
# 序列化會拖到分鐘級。內網可再往上，但先確認 proxy/ADO 沒有連線數限制。
# ADO_DIFF_FETCH_CONCURRENCY=8

HOST=127.0.0.1
PORT=8094

# pr-review-suite 全套設定 —— 由 `python -m shared.settings --example` 產生，
# 不要手改這個 .example；改 shared/settings.py 的 Field 再重生。
# 複製為 /etc/pr-review-suite/suite.env（chmod 600），十個 systemd unit 都指這一份。
#
# systemd 的 EnvironmentFile 不支援行內註解：註解一律獨立成行，
# 等號右邊不可有空白或 # 尾巴（血淚：URL 會出現 %20）。含 $ 或空白的值用單引號。
# 註解掉的行代表「未設 = 預設值 / 停用」；要用再打開。

# ========================================================================
# [ado] Azure DevOps 連線與 diff 抓取（① ado_pr_tools、③ review_result_tools、harvester 共用）。
# ========================================================================

# Azure DevOps Personal Access Token。
# 唯讀服務至少 Code > Read；③ 要真發留言需 Code > Read & Write。
# 全套只填這一次。
ADO_PAT=changeme

# true / false，或 CA bundle 路徑（公司自簽 CA 指向系統合併包，例如 /etc/ssl/certs/ca-certificates.crt）
ADO_VERIFY_SSL=true

# 一條 PR 最多納入幾個檔案。
# 超過的檔案完全不會被抓下來——LLM、semgrep/ruff、確定性 MISSING-TEST 都看不到。
ADO_DIFF_MAX_FILES=300

# 單檔內容上限（bytes），任一側超過就整檔略過並留註記。
ADO_DIFF_MAX_FILE_BYTES=600000

# 抓檔併發度。
# 每檔要抓 base/head 兩份；先確認 proxy/ADO 沒有連線數限制。
ADO_DIFF_FETCH_CONCURRENCY=8

# ========================================================================
# [tools] ①②③ 三個 MCP 工具服務的綁定位址，以及 orchestrator 怎麼找到它們。
# ========================================================================

# 三個工具服務綁定的位址；只給同機 orchestrator 用就留 loopback。
HOST=127.0.0.1

# ① ado_pr_tools 的 port。
# （舊名 PORT 仍認）
ADO_TOOLS_PORT=8094

# ② repo_reader_tools 的 port。
# （舊名 PORT 仍認）
READER_TOOLS_PORT=8095

# ③ review_result_tools 的 port。
# （舊名 PORT 仍認）
RESULT_TOOLS_PORT=8096

# orchestrator 呼叫 ① 的 URL；未設 = http://127.0.0.1:<ADO_TOOLS_PORT>/mcp。
# ADO_TOOLS_URL=

# orchestrator 呼叫 ② 的 URL；未設 = 由 READER_TOOLS_PORT 推得。
# READER_TOOLS_URL=

# orchestrator 呼叫 ③ 的 URL；未設 = 由 RESULT_TOOLS_PORT 推得。
# RESULT_TOOLS_URL=

# ③ 收到 review 稿是否只預覽不真發。
# 內測期間保持 true（安全氣囊）
DRY_RUN=true

# ③ 收到知識蒸餾稿是否真貼到 PR。
# 跟 DRY_RUN 刻意分家，可先行試點。
KNOWLEDGE_POST=false

# ========================================================================
# [llm] OpenAI 相容的 LLM gateway。
# ========================================================================

# 填到「/chat/completions 的上一層」（帶不帶 /v1 以實測為準）
LLM_BASE_URL=http://llm-gateway.internal

# gateway 不驗 key 就留 not-needed。
LLM_API_KEY=not-needed

# planner / reviewer / distiller 用的模型。
LLM_MODEL=changeme

# adversary 專用模型（換一顆腦去自我同意偏差）；未設 = LLM_MODEL。
# LLM_MODEL_ADVERSARY=

# 收口 digest 顧問分析專用模型；未設 = LLM_MODEL。
# LLM_MODEL_DIGEST=

# 單次 LLM 呼叫逾時秒數；逾時重試一次後把例外交還呼叫端走降級。
LLM_TIMEOUT_S=180.0

# ========================================================================
# [langfuse] Langfuse（trace / prompt 版控 / eval）。SDK 自己讀這三個變數；這裡只為了 --show 與 doctor 看得見。
# ========================================================================

# Langfuse 位址。
LANGFUSE_HOST=http://localhost:3000

# pk-lf-…。
LANGFUSE_PUBLIC_KEY=pk-lf-changeme

# sk-lf-…。
LANGFUSE_SECRET_KEY=sk-lf-changeme

# ========================================================================
# [orchestrator] review-orchestrator（8080）的服務層旋鈕。
# ========================================================================

# v1 = 單次 LLM 呼叫（回滾用）；v2 = anatomy→static→plan→平行 reviewer→adversary→synthesis。
# 切 v2 前先跑過 eval 基線。
REVIEW_PIPELINE=v1

# review 完是否呼叫 ③ 回貼。
# 需同時 DRY_RUN=false 才會真發（雙保險）
AUTO_POST=false

# 同一條 PR 在幾秒內重複觸發時，重播快取而不重跑。
REVIEW_DEDUPE_TTL=120.0

# 設了就要求 Bearer；/eval-webhook 刻意不驗。
# 用到 K 段重蒸就必須設（/knowledge/redistill 有 LLM 花費與寫檔語意）
# harvester 讀同一個值。
# ORCH_API_KEY=

# harvester 打重蒸請求的位址（同機 loopback；不走 proxy）
ORCH_URL=http://127.0.0.1:8080

# ========================================================================
# [review] v2 pipeline 旋鈕。全部進 trace metadata；改任何一顆先過 eval。
# ========================================================================

# planner 最多開幾科（Coverage Sweep 可額外 +1）
# 開多科比把單科預算拉大好。
REVIEW_MAX_DIMENSIONS=8

# reviewer / adversary 的 LLM 併發上限。
REVIEW_MAX_PARALLEL=6

# LLM finding 的基礎信心；adversary confirmed ×1.25 / rejected ×0.35。
REVIEW_LLM_BASE_CONF=0.7

# 低於此分的 finding 在 synthesis 被過濾。
REVIEW_MIN_CONFIDENCE=0.55

# 報告輸出上限（純輸出，不影響任何 prompt 長度）
REVIEW_MAX_FINDINGS=30

# 關掉 = 跳過對抗段（A/B 用）
REVIEW_ADVERSARY=true

# adversary 每次呼叫最多審幾條（分塊防注意力稀釋）
ADVERSARY_CHUNK=6

# 每個 reviewer 收到的規則文字上限。
REVIEWER_RULES_MAX_CHARS=20000

# 每一科的 diff 切片總預算；超預算的檔降級 static-only 並進 slices_skipped。
# ⚠ 改這個數會改變 golden set 的語意。
REVIEWER_SLICES_MAX_CHARS=30000

# 單一檔案的切片上限（超過就檔內截斷）
REVIEWER_FILE_SLICE_MAX_CHARS=6000

# ========================================================================
# [static] 確定性靜態掃描（semgrep / ruff / MISSING-TEST）。
# ========================================================================

# auto = 裝了就跑；on = 要跑（沒裝仍只能跳過並註記）；off = 不跑。
# 注意 systemd 的 PATH 要含 venv/bin 才找得到。
STATIC_SEMGREP=auto

# 同 STATIC_SEMGREP。
STATIC_RUFF=auto

# 掃描逾時秒數。
# journal 出現 timed out 就往上調。
STATIC_TIMEOUT=300

# 確定性 MISSING-TEST（diff 有新宣告卻零測試檔 → conf 1.0 保底）
STATIC_MISSING_TEST=true

# ========================================================================
# [repos] 本地乾淨 clone（base 上下文）與 ② repo_reader 的 repo 佈局。
# ========================================================================

# REPOS_ROOT/<repo小寫>/ 一 repo 一顆 clone（target branch），repo-sync timer 保鮮。
# 未設 = 沒有 base 上下文，review 照跑。
# REPOS_ROOT=/opt/repos

# 【已淘汰】舊版單 repo 模式，只有 ② 還認。
# 改用 REPOS_ROOT。
# REPO_ROOT=

# 每個 hunk 從 base 取舊行號附近 ±N 行。
CONTEXT_LINES=6

# base 上下文與 graph 摘要的預算。
# 會進「每一科」的 reviewer prompt。
CONTEXT_MAX_CHARS=24000

# ========================================================================
# [graph] ④ code graph（選配）。GRAPH_TOOLS_URL 與 GRAPH_TOOL_BLAST 都設了才啟用。
# ========================================================================

# code-review-graph serve --http 的 MCP 位址。
# GRAPH_TOOLS_URL=http://127.0.0.1:8097/mcp

# 影響半徑工具名（裝好後 list tools 確認）
# GRAPH_TOOL_BLAST=get_impact_radius_tool

# 參數 JSON 樣板；$files / $repo / $repo_dir 會被代入。
# 含 $ 與空白，被 shell source 時要用單引號。
# 多 repo 自動切庫：{"changed_files": $files, "repo_root": "<REPOS_ROOT>/$repo_dir"}。
GRAPH_TOOL_BLAST_ARGS='{"files": $files}'

# graph server 綁定的 repo 名（小寫）；設了之後其他 repo 自動跳過 graph。
# 多 repo 切庫模式留空。
# GRAPH_REPO=

# ========================================================================
# [rules] 團隊規則 repo（本機 clone）。RULES_ROOT 未設 = 規則功能整個靜默停用。
# ========================================================================

# 規則 repo 的本機 clone；每次 review 用到的 commit SHA 會進 trace。
# RULES_ROOT=/opt/pr-review-rules

# 規則目錄名（<RULES_ROOT>/rules/）
RULES_SUBDIR=rules

# 每次 review 必載的子目錄名。
RULES_COMMON_DIR=common

# 組進 prompt 的規則總量上限（字元）
RULES_MAX_CHARS=60000

# ========================================================================
# [knowledge] 知識迴圈（K 段，選配）。KNOWLEDGE_ROOT 未設 = 注入與蒸餾皆靜默停用。
# ========================================================================

# 本地 knowledge repo 路徑（harvester timer 是唯一 commit 者）
# KNOWLEDGE_ROOT=/opt/pr-review-knowledge

# 進帳本的目標分支（逗號分隔、支援萬用字元，例：master,release/*）
KNOWLEDGE_BRANCHES=master,main

# Stage 04 注入區塊總上限；同樣會進 reviewer prompt。
KNOWLEDGE_MAX_CHARS=18000

# 蒸餾看得到的 diff 切片預算；超預算的檔會留註記並進 distill_slices_skipped。
DISTILL_DIFF_MAX_CHARS=100000

# stale 重蒸（draft 之後又有 push → 用最終 diff 重蒸一次，≤2 次）
# false = 回到 stale 直接丟稿。
KNOWLEDGE_REDISTILL=true

# 週期驗收 PR 的 source 分支樣式；符合者不蒸餾、作為收口儀式。
KNOWLEDGE_CYCLE_SOURCE=release/*

# 週期驗收 PR 的 target 分支。
KNOWLEDGE_CYCLE_TARGET=master

# 收口 digest 要不要貼到驗收 PR（false = 全暗影子模式：照樣落地、不發留言）
KNOWLEDGE_DIGEST=true

# digest 的「Needs a look」顧問段（LLM 提案，落地路徑不讀）
# false = 純清單。
KNOWLEDGE_DIGEST_LLM=true

# 顧問旗標上限（防洗版）
KNOWLEDGE_DIGEST_MAX_FLAGS=12

# 實作推翻規則時收口是否拔掉那條不變式（沉默即拔；回 keep <ID> 否決）
# false = 只提案不執行。
KNOWLEDGE_RETIRE_ON_CONTRADICTION=true

# ========================================================================
# [eval] 離線考試（run_eval / run_distill_eval）。門檻未設 = report-only。
# ========================================================================

# 知識依賴題的種子帳本；未設 = eval/fixtures/knowledge。
# EVAL_KNOWLEDGE_ROOT=

# 對照組（同一批知識題再跑一次 KNOWLEDGE_ROOT=""）；關掉就沒有 delta。
EVAL_KNOWLEDGE_AB=true

# CI gate：must_catch_recall 下限。
EVAL_MIN_RECALL=0.0

# CI gate：noise rate 上限。
# EVAL_MAX_NOISE=

# CI gate：forbidden-hit rate 上限。
# EVAL_MAX_FORBIDDEN=

# knowledge_delta 的門檻。
# 先 report-only，基線穩定兩輪再設。
# EVAL_MIN_KNOWLEDGE_DELTA=

# 蒸餾考卷的門檻，同樣先 report-only。
# EVAL_MIN_DISTILL_SCORE=

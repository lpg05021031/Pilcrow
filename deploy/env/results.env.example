# 複製為 /etc/pr-review-suite/results.env（chmod 600）
# ③ review-result-tools —— 發/查 review。真發評論需 PAT 有 Code > Read & Write

ADO_PAT=changeme
# HTTPS_PROXY=http://proxy.corp:3128
ADO_VERIFY_SSL=/etc/ssl/certs/ca-certificates.crt

# 內測期間保持 true（安全氣囊）；要真的發評論到 PR 才改 false
DRY_RUN=true

HOST=127.0.0.1
PORT=8096

# 知識蒸餾稿是否真貼到 PR（跟 review 的 DRY_RUN 分家，可先行試點）
KNOWLEDGE_POST=false

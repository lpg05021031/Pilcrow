# 複製為 /etc/systemd/system/pr-review-ado.service
[Unit]
Description=pr-review - ado-pr-tools (8094)
After=network.target

[Service]
EnvironmentFile=/etc/pr-review-suite/suite.env
WorkingDirectory=/opt/pr-review-suite
ExecStart=/opt/pr-review-suite/venv/bin/python -m tools.ado_pr_tools.server
Restart=always
# 改成實際跑服務的帳號（machine 上必須存在；id <帳號> 驗證）
User=svc-review

[Install]
WantedBy=multi-user.target

# 複製為 /etc/systemd/system/pr-review-repo-sync.service（改 User）
[Unit]
Description=sync PR-review repo clones + rebuild code graph

[Service]
Type=oneshot
User=svc-review
# REPOS_ROOT 來自同一份 suite.env
EnvironmentFile=/etc/pr-review-suite/suite.env
ExecStart=/opt/pr-review-suite/deploy/bin/repo-sync.sh

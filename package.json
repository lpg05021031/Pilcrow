{
  "name": "pilcrow",
  "productName": "Pilcrow",
  "version": "2.9.1",
  "private": true,
  "description": "Desktop workbench for Claude Code on Linux",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "pilcrow": "bin/pilcrow"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "bin/pilcrow",
    "server": "node server/main.js --shell=none",
    "mock": "node test/mock/mock-server.mjs 5300",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint web/src test",
    "test": "npm run check && npm run lint && npm run test:unit && npm run test:e2e && npm run test:webkit",
    "test:unit": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "test:webkit": "node test/webkit/run.mjs",
    "release": "node scripts/release.mjs",
    "installers": "python scripts/make-installers.py --verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "electron": "44.7.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lucide-react": "1.57.0",
    "marked": "18.1.1",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "3.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "6.4.4",
    "vitest": "^3.2.7",
    "zustand": "5.0.15"
  }
}
